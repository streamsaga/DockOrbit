# Railway Backend Environment Variables Example
# Set these in your Railway Service > Variables tab

NODE_ENV=production
# PORT is automatically injected by Railway, but defaults to 5000 if needed
PORT=5000

# Security & CORS
# TRUST_PROXY=true is essential on Railway/reverse proxies for client IP rate limiting
TRUST_PROXY=true
# Set to your Vercel frontend URL (e.g. https://your-project.vercel.app)
CORS_ORIGIN=https://your-project.vercel.app

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# API Keys & Authentication
YOUTUBE_API_KEY=your_youtube_api_key
JWT_SECRET=your_long_random_jwt_secret
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Settings (for OTP & Email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional flag: set to true to bypass YouTube/OpenAI APIs during initial testing
USE_MOCK_DATA=false
